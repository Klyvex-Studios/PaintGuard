<UserControl x:Class="VaultGuard360.Views.SecuritySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings" Foreground="{StaticResource BrushTextMain}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Configure removable-media protection, inspect runtime state and contact support." Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StitchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Removable media protection" Foreground="{StaticResource BrushTextMain}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <Border Style="{StaticResource CardInnerStyle}">
                            <DockPanel>
                                <StackPanel Width="300">
                                    <TextBlock Text="USB &amp; AutoRun protection" Foreground="{StaticResource BrushTextMain}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Vaccinates removable drives only and applies a reversible per-user AutoRun policy. Existing autorun.inf files or folders are never overwritten by the vaccine." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsRemovableMediaProtectionEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="VaultGuard records the previous AutoRun setting before changing it, so disabling this option can restore the value it replaced." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StitchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Runtime" Foreground="{StaticResource BrushTextMain}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <Border Style="{StaticResource CardInnerStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Product" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                    <TextBlock Text="VaultGuard 360" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Publisher" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                    <TextBlock Text="Klyvex Studios" Foreground="{StaticResource BrushPrimaryContainer}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Engine" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                    <TextBlock Text="{Binding EngineState}" Foreground="{StaticResource BrushSecondary}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Mode" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                    <TextBlock Text="{Binding RuntimeMode}" Foreground="{StaticResource BrushTextMain}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="The desktop app uses its in-process PowerShell engine for normal scan, vault and remediation operations." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource StitchCardStyle}">
                <StackPanel>
                    <TextBlock Text="Support &amp; feedback" Foreground="{StaticResource BrushTextMain}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Your message is opened in your local mail client. VaultGuard does not silently post support content to a third-party form service." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Name" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Subject" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ContactSubject, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Message" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ContactMessage, UpdateSourceTrigger=PropertyChanged}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <DockPanel>
                        <Button Content="Open support message" Style="{StaticResource PrimaryButtonStyle}" Click="SendSupport_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding SupportStatus}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
