<UserControl x:Class="VaultGuard360.Views.ScanCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Scan center" Foreground="{StaticResource BrushTextMain}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Run live family-specific detectors and optionally remediate confirmed threats." Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource BrushPrimaryContainer}" FontSize="10" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource StitchCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Scan target" Foreground="{StaticResource BrushTextMain}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Choose a local drive or directory. Network shares can be entered manually." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Use C:\" Style="{StaticResource SecondaryButtonStyle}" Click="SetPathC_Click" />
                            <Button Grid.Column="2" Content="Use D:\" Style="{StaticResource SecondaryButtonStyle}" Click="SetPathD_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Safe scan mode" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="When enabled, detections are reported but no files are changed." Foreground="{StaticResource BrushTextMuted}" FontSize="9" TextWrapping="Wrap" Width="230" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsDryRun}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Button Content="Start scan" Style="{StaticResource PrimaryButtonStyle}" Click="StartScan_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StitchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Verdicts" Foreground="{StaticResource BrushTextMain}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushSecondary}" BorderThickness="4,1,1,1" Margin="0,0,0,8">
                            <DockPanel><TextBlock Text="Clean" Foreground="{StaticResource BrushTextMain}" /><TextBlock Text="{Binding CleanCount}" Foreground="{StaticResource BrushSecondary}" FontWeight="Bold" HorizontalAlignment="Right" /></DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushTertiary}" BorderThickness="4,1,1,1" Margin="0,0,0,8">
                            <DockPanel><TextBlock Text="Suspicious" Foreground="{StaticResource BrushTextMain}" /><TextBlock Text="{Binding SuspiciousCount}" Foreground="{StaticResource BrushTertiary}" FontWeight="Bold" HorizontalAlignment="Right" /></DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardInnerStyle}" BorderBrush="{StaticResource BrushError}" BorderThickness="4,1,1,1">
                            <DockPanel><TextBlock Text="Infected" Foreground="{StaticResource BrushTextMain}" /><TextBlock Text="{Binding InfectedCount}" Foreground="{StaticResource BrushError}" FontWeight="Bold" HorizontalAlignment="Right" /></DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource StitchCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Engine activity" Foreground="{StaticResource BrushTextMain}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Live messages from the in-process PowerShell security engine." Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource BrushSurfaceLowest}" BorderBrush="#2C3B35" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LogOutput}" Foreground="#C9E8DA" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
