<UserControl x:Class="VaultGuard360.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Security overview" Foreground="{StaticResource BrushTextMain}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Live protection state, scans, vault health and recovery actions." Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="Quick scan" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="QuickScan_Click" />
            </DockPanel>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StitchCardStyle}" MinHeight="240">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Protection status" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="14" />
                            <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Right">
                                <TextBlock Text="LIVE ENGINE" Foreground="{StaticResource BrushPrimaryContainer}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </DockPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                            <TextBlock Text="{Binding SystemStatus}" Foreground="{StaticResource BrushPrimary}" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource BrushTextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Protection claims are now driven by engine state, not hard-coded UI labels." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StitchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Last scan" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding LastScanFiles, StringFormat={}{0:N0}}" Foreground="{StaticResource BrushPrimary}" FontSize="30" FontWeight="SemiBold" Margin="0,24,0,0" />
                        <TextBlock Text="files inspected" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                        <Border Height="1" Background="{StaticResource BrushOutline}" Margin="0,16" />
                        <DockPanel>
                            <TextBlock Text="Threats" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding LastThreats}" Foreground="{StaticResource BrushError}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StitchCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Quarantine" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding QuarantineCount}" Foreground="{StaticResource BrushTertiary}" FontSize="30" FontWeight="SemiBold" Margin="0,24,0,0" />
                        <TextBlock Text="isolated item(s)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                        <TextBlock Text="Open Vault &amp; Quarantine to inspect, restore or permanently remove items." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource StitchCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Detection &amp; recovery pipeline" Foreground="{StaticResource BrushTextMain}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Scan → classify → quarantine → restore from verified baseline → repair persistence → harden removable media." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,4,0,16" />
                        <WrapPanel>
                            <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,10,10"><TextBlock Text="1  Detect" Foreground="{StaticResource BrushTextMain}" /></Border>
                            <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,10,10"><TextBlock Text="2  Isolate" Foreground="{StaticResource BrushTextMain}" /></Border>
                            <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,10,10"><TextBlock Text="3  Restore" Foreground="{StaticResource BrushTextMain}" /></Border>
                            <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,10,10"><TextBlock Text="4  Harden" Foreground="{StaticResource BrushTextMain}" /></Border>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run remediation" Style="{StaticResource SecondaryButtonStyle}" Margin="20,0,0,0" VerticalAlignment="Center" Click="Remediate_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
