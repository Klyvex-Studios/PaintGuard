<Window x:Class="VaultGuard360.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VaultGuard360.Views"
        xmlns:vm="clr-namespace:VaultGuard360.ViewModels"
        Title="VaultGuard 360"
        Height="760" Width="1220" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BrushBackground}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushOutline}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Dark navigation rail balances the light workspace -->
            <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,22,18,20">
                        <TextBlock Text="VAULTGUARD" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="360 Security" Foreground="{StaticResource BrushSidebarMuted}" FontSize="12" Margin="0,2,0,0" />
                        <Border Background="#30443B" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Margin="0,14,0,0">
                            <TextBlock Text="Klyvex Studios" Foreground="#DDF1E8" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,8">
                        <TextBlock Text="PROTECTION" Foreground="#82918A" FontSize="10" FontWeight="Bold" Margin="12,0,0,8" />
                        <Button Content="Home" Style="{StaticResource NavItemButtonStyle}" Click="NavDashboard_Click" />
                        <Button Content="Scan Center" Style="{StaticResource NavItemButtonStyle}" Click="NavScanCenter_Click" />
                        <Button Content="Vault &amp; Quarantine" Style="{StaticResource NavItemButtonStyle}" Click="NavVaultManager_Click" />
                        <Button Content="Settings" Style="{StaticResource NavItemButtonStyle}" Click="NavSettings_Click" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,0,14,18" Background="#26362F" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Engine status" Foreground="#8FA098" FontSize="10" />
                            <TextBlock Text="{Binding DashboardVM.SystemStatus}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding DashboardVM.StatusDetail}" Foreground="{StaticResource BrushSidebarMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Native-style title bar -->
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BrushOutline}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="22,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="VaultGuard 360" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Windows malware defense and recovery" Foreground="{StaticResource BrushTextMuted}" FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="NotificationButton" Content="Alerts" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0" Click="ToggleNotifications_Click" />
                            <Button x:Name="ShieldButton" Content="Protection" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0" Click="ToggleShield_Click" />
                            <Button x:Name="UsbButton" Content="USB" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0" Click="ToggleUsb_Click" />
                            <Button Content="Quick scan" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,12,0" Click="QuickScanTop_Click" />

                            <Button Content="—" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextMuted}" Width="38" Height="32" Click="MinimizeWindow_Click" />
                            <Button Content="□" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextMuted}" Width="38" Height="32" Click="MaximizeWindow_Click" />
                            <Button Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextMuted}" Width="38" Height="32" Click="CloseWindow_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanCenterView /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:VaultViewModel}"><views:VaultManagerView /></DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SecuritySettingsView /></DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <Popup IsOpen="{Binding IsNotificationFlyoutOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=NotificationButton}" AllowsTransparency="True">
                    <Border Style="{StaticResource StitchCardStyle}" Width="360" MaxHeight="320" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Foreground="{StaticResource BrushTextMain}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding NotificationService.Notifications}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,7">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextMain}" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBlock Text="{Binding TimeAgo}" Foreground="{StaticResource BrushTextMuted}" FontSize="9" HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup IsOpen="{Binding IsUsbFlyoutOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=UsbButton}" AllowsTransparency="True">
                    <Border Style="{StaticResource StitchCardStyle}" Width="320" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="USB protection" Foreground="{StaticResource BrushTextMain}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="The PowerShell volume-arrival watcher is started with the protection engine. Connected media is vaccinated only when the live engine reports success." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10" />
                            <Border Style="{StaticResource CardInnerStyle}">
                                <DockPanel>
                                    <TextBlock Text="Live watcher" Foreground="{StaticResource BrushTextMain}" FontSize="11" />
                                    <TextBlock Text="{Binding IsRealTimeProtected, StringFormat=Enabled: {0}}" Foreground="{StaticResource BrushSecondary}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup IsOpen="{Binding IsShieldFlyoutOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ShieldButton}" AllowsTransparency="True">
                    <Border Style="{StaticResource StitchCardStyle}" Width="330" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Protection engine" Foreground="{StaticResource BrushTextMain}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DashboardVM.StatusDetail}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <Border Style="{StaticResource CardInnerStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Active detection families" Foreground="{StaticResource BrushTextMain}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Paint/Geacata · Shortcut worms · Expiro PE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="Toggle live USB monitoring" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleProtection_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Border>
</Window>
